rules_version = '2';

// Reglas de Cloud Firestore del proyecto pokedex-jorge (las mismas que están
// publicadas en la consola de Firebase). Cada entrenador sólo puede leer y
// escribir sus propios datos, guardados en entrenadores/{uid}.
service cloud.firestore {
  match /databases/{database}/documents {
    match /entrenadores/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
